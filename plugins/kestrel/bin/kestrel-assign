#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
const runtime = resolve(dirname(fileURLToPath(import.meta.url)), "kestrel-plugin");
const result = spawnSync(process.execPath, [runtime, "assign", ...process.argv.slice(2)], { stdio: "inherit", env: process.env });
process.exit(result.status ?? 1);
