{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greg-asher/agent-skills/analysis/workspace-model.schema.json",
  "title": "Analysis Workspace Model",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "workspace", "analysis", "boundaries", "components", "relationships", "evidence", "findings", "unknowns"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "generatedAt": {"type": "string"},
    "workspace": {
      "type": "object",
      "required": ["root", "revision"],
      "properties": {
        "root": {"type": "string"},
        "revision": {"type": ["string", "null"]},
        "repository": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "analysis": {
      "type": "object",
      "required": ["methods", "coveredSources", "excludedSources", "limitations"],
      "properties": {
        "methods": {"type": "array", "items": {"type": "string"}},
        "coveredSources": {"type": "array", "items": {"type": "string"}},
        "excludedSources": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "boundaries": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "components": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "runtimeDependencies": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "environmentVariables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "evidenceIds"],
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "evidenceIds": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "support": {"type": "string", "enum": ["observed-current", "demonstrated-test", "static-analysis", "declared", "inferred", "unknown"]},
    "entity": {
      "type": "object",
      "required": ["id", "name", "kind", "evidenceIds"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "kind": {"type": "string"},
        "description": {"type": "string"},
        "paths": {"type": "array", "items": {"type": "string"}},
        "evidenceIds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": ["id", "from", "to", "kind", "support", "evidenceIds"],
      "properties": {
        "id": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "kind": {"type": "string"},
        "support": {"$ref": "#/$defs/support"},
        "evidenceIds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "support", "path", "locator"],
      "properties": {
        "id": {"type": "string"},
        "support": {"$ref": "#/$defs/support"},
        "path": {"type": "string"},
        "locator": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "statement", "support", "evidenceIds"],
      "properties": {
        "id": {"type": "string"},
        "statement": {"type": "string"},
        "support": {"$ref": "#/$defs/support"},
        "evidenceIds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
